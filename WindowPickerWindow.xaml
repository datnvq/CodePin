<Window x:Class="CodePin.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghim Cửa Sổ Khác" Height="480" Width="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#585B70"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" BorderBrush="#45475A" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📌" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ghim Cửa Sổ Ứng Dụng Khác" FontSize="15" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Click="BtnClose_Click" 
                        Style="{StaticResource RoundedButtonStyle}" Background="Transparent" 
                        Foreground="#F38BA8" FontSize="14" Padding="6,2"/>
            </Grid>

            <!-- Search Box & Refresh -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="TxtSearch" Height="32" VerticalContentAlignment="Center"
                             Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                             Padding="8,0" FontSize="13" TextChanged="TxtSearch_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock x:Name="TxtPlaceholder" Text="🔍 Tìm kiếm cửa sổ..." Foreground="#6C7086" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13"/>
                </Grid>

                <Button Grid.Column="1" Content="🔄 Làm mới" Margin="8,0,0,0" Height="32"
                        Style="{StaticResource RoundedButtonStyle}" Click="BtnRefresh_Click"/>
            </Grid>

            <!-- Windows List -->
            <ListBox x:Name="LstWindows" Grid.Row="2" Background="#181825" BorderBrush="#313244" 
                     BorderThickness="1" Foreground="#CDD6F4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#313244"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="#9399B2" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Width="92" Height="28"
                                    Tag="{Binding}" Click="BtnTogglePin_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Background" Value="#A6E3A1"/>
                                                <Setter Property="Foreground" Value="#11111B"/>
                                                <Setter Property="Content" Value="📌 Đang ghim"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="False">
                                                <Setter Property="Background" Value="#45475A"/>
                                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                                <Setter Property="Content" Value="Ghim"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Tip at bottom -->
            <Border Grid.Row="3" Background="#313244" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                <TextBlock Text="💡 Mẹo: Bấm Ctrl + Alt + T trên bất kỳ cửa sổ nào để ghim ngay!" 
                           Foreground="#A6ADC8" FontSize="11.5" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
