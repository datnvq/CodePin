<Window x:Class="CodePin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CodePin - Always On Top"
        Height="420" Width="640"
        MinHeight="170" MinWidth="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseWheel="Window_MouseWheel"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Button Style for Title Bar -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Icon Context Menu -->
        <ContextMenu x:Key="TrayContextMenu" Background="#1E1E2E" BorderBrush="#45475A" BorderThickness="1.5">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Margin" Value="4,3"/>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="📌 Mở CodePin" FontWeight="Bold" Foreground="#A6E3A1" Click="TrayMenuOpen_Click"/>
            <Separator/>
            <MenuItem Header="📋 Dán ảnh từ Clipboard" Click="MenuPaste_Click" InputGestureText="Ctrl+V"/>
            <MenuItem Header="📝 Trích xuất Code (OCR)" Click="MenuOcr_Click" InputGestureText="Ctrl+T"/>
            <MenuItem Header="🪟 Ghim cửa sổ khác..." Click="MenuWindowPicker_Click" ToolTip="Hoặc bấm Ctrl+Alt+T trên cửa sổ bất kỳ"/>
            <MenuItem Header="🎯 Khôi phục vị trí mặc định" Click="TrayMenuResetPosition_Click"/>
            <MenuItem Header="🖥️ Tạo lối tắt ngoài Desktop" Click="MenuCreateShortcut_Click"/>
            <Separator/>
            <MenuItem Header="❌ Thoát hoàn toàn" Click="TrayMenuExit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Main Container Card -->
    <Border x:Name="RootBorder" 
            Margin="10" 
            Background="#1E1E2E" 
            BorderBrush="#45475A" 
            BorderThickness="1.5" 
            CornerRadius="10">
        
        <Border.ContextMenu>
            <ContextMenu x:Name="MainContextMenu" Opened="ContextMenu_Opened">
                <MenuItem Header="📋 Dán ảnh từ Clipboard" Click="MenuPaste_Click" InputGestureText="Ctrl+V"/>
                <MenuItem Header="📁 Mở file ảnh..." Click="MenuOpenFile_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="📝 Trích xuất Code (OCR -> Copy text)" Click="MenuOcr_Click" InputGestureText="Ctrl+T"/>
                <Separator/>
                <MenuItem Header="🪟 Ghim cửa sổ ứng dụng khác..." Click="MenuWindowPicker_Click" ToolTip="Hoặc bấm Ctrl+Alt+T trên cửa sổ bất kỳ"/>
                <MenuItem x:Name="MenuTopmostItem" Header="📌 Luôn nổi trên cùng (Topmost)" IsCheckable="True" IsChecked="True" Click="MenuTopmost_Click"/>
                <MenuItem Header="🔄 Đặt lại kích thước &amp; Zoom" Click="MenuResetZoom_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="🎚️ Độ trong suốt (Opacity)">
                    <MenuItem Header="100% (Rõ nét)" Click="MenuOpacity_Click" Tag="1.0"/>
                    <MenuItem Header="85%" Click="MenuOpacity_Click" Tag="0.85"/>
                    <MenuItem Header="70%" Click="MenuOpacity_Click" Tag="0.70"/>
                    <MenuItem Header="50% (Bán trong suốt)" Click="MenuOpacity_Click" Tag="0.50"/>
                    <MenuItem Header="30% (Mờ nhẹ)" Click="MenuOpacity_Click" Tag="0.30"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="👻 Bật/Tắt chế độ xuyên chuột (Click-through)" Click="MenuClickThrough_Click" ToolTip="Nhấn F8 hoặc Ctrl+Alt+P để bật/tắt"/>
                <MenuItem Header="🗑️ Xoá ảnh / Làm mới phiên" Click="MenuClearSession_Click"/>
                <MenuItem Header="🖥️ Tạo lối tắt ngoài Desktop" Click="MenuCreateShortcut_Click"/>
                <Separator/>
                <MenuItem Header="➖ Thu nhỏ xuống khay" Click="MenuClose_Click" InputGestureText="Esc"/>
                <MenuItem Header="❌ Thoát hoàn toàn" Click="TrayMenuExit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP FLOATING CONTROL BAR (Responsive / Flex) -->
            <Border Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                    Background="#181825" CornerRadius="9,9,0,0" Padding="8,4"
                    BorderBrush="#313244" BorderThickness="0,0,0,1"
                    x:Name="TopBar">
                <DockPanel LastChildFill="False">
                    <!-- Left: Status indicators -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPinIndicator" Text="📌 ON TOP" FontSize="11" FontWeight="Bold" Foreground="#A6E3A1" Margin="4,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtInfo" Text="100% | Mờ: 100%" FontSize="11" Foreground="#9399B2" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Rightmost Window Controls: ALWAYS visible, anchored to the right -->
                    <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="✕" 
                            ToolTip="Thu nhỏ xuống khay (Esc) - Chuột phải chọn Thoát để đóng hẳn" 
                            Style="{StaticResource HeaderButtonStyle}" Foreground="#F38BA8" FontWeight="Bold" Width="26" 
                            Click="MenuClose_Click"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnTopmost" Content="📌" 
                            ToolTip="Bật/Tắt luôn nổi trên cùng" 
                            Style="{StaticResource HeaderButtonStyle}" Width="26" 
                            Click="BtnToggleTopmost_Click"/>

                    <!-- Action Buttons: Docked to the left of Close/Topmost, responsive -->
                    <Button DockPanel.Dock="Right" x:Name="BtnResetZoom" Content="🔄 100%" ToolTip="Đặt lại thu phóng (Ctrl + 0)" Style="{StaticResource HeaderButtonStyle}" Click="MenuResetZoom_Click"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnWindowPicker" Content="🪟 Ghim" ToolTip="Ghim cửa sổ ứng dụng khác (Ctrl + Alt + T)" Style="{StaticResource HeaderButtonStyle}" Click="MenuWindowPicker_Click"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnOcr" Content="📝 OCR" ToolTip="Trích xuất &amp; Copy Code từ ảnh (Ctrl + T)" Style="{StaticResource HeaderButtonStyle}" Background="#313244" Foreground="#89B4FA" FontWeight="SemiBold" Click="MenuOcr_Click"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnPaste" Content="📋 Dán" ToolTip="Dán ảnh mới (Ctrl + V)" Style="{StaticResource HeaderButtonStyle}" Click="MenuPaste_Click"/>
                </DockPanel>
            </Border>

            <!-- 2. CONTENT AREA -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- EMPTY / WELCOME STATE (when no image is loaded) -->
                <Grid x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📌" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="CodePin - Ghim Ảnh &amp; Cửa Sổ Nổi" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <Border Background="#313244" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📋 Nhấn Ctrl + V để dán ảnh vừa chụp (Win + Shift + S)" Foreground="#A6ADC8" FontSize="12.5" Margin="0,2"/>
                                <TextBlock Text="📝 Nhấn Ctrl + T để trích xuất Code từ ảnh (OCR tự động)" Foreground="#89B4FA" FontSize="12.5" Margin="0,2"/>
                                <TextBlock Text="🪟 Bấm Ctrl + Alt + T trên bất kỳ cửa sổ nào để ghim nổi" Foreground="#A6E3A1" FontSize="12.5" Margin="0,2"/>
                                <TextBlock Text="📁 Kéo thả file ảnh bất kỳ vào đây để xem" Foreground="#A6ADC8" FontSize="12.5" Margin="0,2"/>
                                <TextBlock Text="🖱️ Lăn chuột để Zoom | Shift + Lăn chuột chỉnh độ mờ" Foreground="#A6ADC8" FontSize="12.5" Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📋 Dán từ Clipboard" Style="{StaticResource HeaderButtonStyle}" 
                                    Background="#89B4FA" Foreground="#11111B" FontWeight="SemiBold" 
                                    Padding="12,6" Margin="4,0" Click="MenuPaste_Click"/>
                            <Button Content="🪟 Ghim Cửa Sổ Khác" Style="{StaticResource HeaderButtonStyle}" 
                                    Background="#A6E3A1" Foreground="#11111B" FontWeight="SemiBold" 
                                    Padding="12,6" Margin="4,0" Click="MenuWindowPicker_Click"/>
                            <Button Content="📁 Chọn file ảnh..." Style="{StaticResource HeaderButtonStyle}" 
                                    Background="#45475A" Foreground="#CDD6F4" 
                                    Padding="12,6" Margin="4,0" Click="MenuOpenFile_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- IMAGE DISPLAY AREA -->
                <Grid x:Name="ImageContainer" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="Image_MouseLeftButtonDown">
                    <Image x:Name="PinnedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0" CenterX="0.5" CenterY="0.5"/>
                                <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>

                <!-- TOAST NOTIFICATION PILL -->
                <Border x:Name="ToastNotification" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Background="#EE11111B" BorderBrush="#89B4FA" BorderThickness="1.5"
                        CornerRadius="8" Padding="14,7" Margin="0,0,0,16" Visibility="Collapsed"
                        Panel.ZIndex="999">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <TextBlock x:Name="TxtToast" Text="Đã copy code vào clipboard!" Foreground="#CDD6F4" FontSize="12.5" FontWeight="SemiBold"/>
                </Border>

                <!-- Resize grip in bottom-right corner -->
                <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Margin="0,0,2,2" Cursor="SizeNWSE"
                            PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown"/>
            </Grid>
        </Grid>
    </Border>
</Window>
